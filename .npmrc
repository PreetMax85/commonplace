# The ONNX Runtime install step otherwise downloads about 270 MB of NVIDIA
# GPU libraries on Linux. The app runs on CPU, so they are never loaded.
# npm warns that it does not know this key: it is read by onnxruntime-node,
# not npm. If a future npm stops passing it on, the download returns, but
# next.config.ts still keeps those libraries out of the deploy.
onnxruntime-node-install=skip
